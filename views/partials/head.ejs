<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title + " - Asim'UT" : "Asim'UT" %></title>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Pinyon+Script&family=Plus+Jakarta+Sans:wght@400;700;800&family=Syncopate:wght@700&display=swap" rel="stylesheet" />

<!-- Tailwind CDN (v3.4) -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          clean: ['Plus Jakarta Sans', 'sans-serif'],
          signature: ['Pinyon Script', 'cursive'],
          wide: ['Syncopate', 'sans-serif'],
        },
        colors: {
          asimov: {
            bg: '#0A0A0A',
            bgSecondary: '#050505',
            accent: '#00DC82',
            accentHover: '#00C474',
            outline: 'rgba(255, 255, 255, 0.05)',
            textMuted: '#888888',
          }
        },
        boxShadow: {
          'glow': '0 4px 20px rgba(0, 220, 130, 0.2)',
          'glow-lg': '0 10px 40px rgba(0, 220, 130, 0.3)',
        },
        borderRadius: {
          'xl': '12px',
          '2xl': '18px',
          '3xl': '24px',
        }
      }
    }
  }
</script>

<style>
  .glass {
    background: #0D0D0D;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .text-outline {
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.3);
    color: transparent;
  }
  .text-outline-accent {
    -webkit-text-stroke: 1px #00DC82;
    color: transparent;
  }
</style>

<!-- Global CSS -->
<link rel="stylesheet" href="/css/main.css" />

<!-- Passage de la variable globale au client -->
<% if (typeof utilisateur !== 'undefined') { %>
<script>
  window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
</script>
<% } %>
