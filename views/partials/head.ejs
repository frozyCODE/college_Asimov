<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title + " - Asim'UT" : "Asim'UT" %></title>

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<!-- Tailwind CDN (v3.4) -->
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        fontFamily: {
          sans: ['Inter', 'sans-serif'],
        },
        colors: {
          asimov: {
            50: '#f0f9ff',
            100: '#e0f2fe',
            500: '#0ea5e9',
            600: '#0284c7',
            700: '#0369a1',
            900: '#0c4a6e',
          }
        }
      }
    }
  }
</script>

<!-- Global CSS (Overrides mineurs si besoin) -->
<link rel="stylesheet" href="/css/main.css" />

<!-- Passage de la variable globale au client -->
<% if (typeof utilisateur !== 'undefined') { %>
<script>
  window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
</script>
<% } %>
