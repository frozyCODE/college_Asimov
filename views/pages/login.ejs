<!DOCTYPE html>
<html lang="fr" class="bg-gray-100">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-asimov-bg text-white font-sans selection:bg-asimov-accent/30 flex flex-col min-h-screen">
  
  <%- include('../partials/navbar', { currentRoute: '/login' }) %>

  <main class="flex-1 flex flex-col items-center justify-center p-6 relative overflow-hidden">

    <div class="w-full max-w-md">
      <div class="flex justify-center mb-12">
        <div class="w-24 h-24 bg-white/5 rounded-2xl flex items-center justify-center border border-white/10">
           <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l9-5-9-5-9 5 9 5z"></path>
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
           </svg>
        </div>
      </div>

      <div class="bg-asimov-bgSecondary border border-white/10 p-10 rounded-2xl shadow-xl relative">
        <div class="text-center mb-10">
          <h1 class="text-3xl font-wide uppercase mb-2 tracking-widest">Connexion</h1>
          <p class="text-asimov-textMuted text-xs font-bold uppercase tracking-[0.2em]">Accès Portail École</p>
        </div>

        <form action="/login" method="POST" class="space-y-6">
          <div class="space-y-2">
            <label for="email" class="text-[10px] font-black uppercase tracking-[0.15em] text-asimov-textMuted ml-1">Email professionnel</label>
            <input type="email" name="email" id="email" required 
                   class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm placeholder-white/20"
                   placeholder="nom@ecole-asimov.fr">
          </div>
          <div class="space-y-2">
            <label for="password" class="text-[10px] font-black uppercase tracking-[0.15em] text-asimov-textMuted ml-1">Mot de passe</label>
            <input type="password" name="password" id="password" required 
                   class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm placeholder-white/20"
                   placeholder="••••••••">
          </div>
          
          <button type="submit" class="w-full bg-asimov-accent hover:bg-asimov-accentHover text-white font-black uppercase tracking-[0.2em] py-5 rounded-xl transition-all active:scale-[0.98] mt-4">
            Se connecter
          </button>
        </form>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mt-8 p-4 bg-red-500/10 border border-red-500/20 rounded-2xl text-red-500 text-xs font-bold text-center uppercase tracking-wider animate-shake">
            <%= error %>
          </div>
        <% } %>
      </div>

      <div class="mt-12 text-center">
        <p class="text-asimov-textMuted text-[10px] font-bold uppercase tracking-widest">© 2026 COLLÈGE ASIMOV • SYSTÈME SÉCURISÉ</p>
      </div>
    </div>
  </main>

  <script src="/js/login.js"></script>
</body>
</html>
