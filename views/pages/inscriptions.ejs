<!DOCTYPE html>
<html lang="fr" class="bg-gray-50">
<head>
  <%- include('../partials/head') %>
</head>
<body class="flex flex-col min-h-screen text-gray-900 font-sans">
  
  <%- include('../partials/navbar', { currentRoute: '/inscriptions' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
  </script>

  <main class="flex-1 max-w-6xl w-full mx-auto p-6 mt-4">
    <div class="flex justify-between items-end border-b pb-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold mb-1">Inscriptions</h1>
        <p class="text-gray-600">Affectez les élèves dans leurs classes respectives.</p>
      </div>
      <% if (['Secretariat', 'Proviseur'].includes(utilisateur.role)) { %>
        <button onclick="ouvrirModalInscription()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 text-sm">
          + Nouvelle Inscription
        </button>
      <% } %>
    </div>

    <!-- Recherche Inscriptions -->
    <div class="bg-white p-4 border border-gray-300 mb-6 flex gap-2">
      <input type="number" id="input-eleve-id" min="1" placeholder="ID élève (ex: 1)" class="flex-1 px-3 py-2 border border-gray-300 focus:outline-none focus:border-blue-500 text-sm">
      <button id="btn-rechercher-insc" onclick="rechercherInscriptions()" class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 text-sm font-medium">Rechercher</button>
    </div>

    <!-- Table -->
    <div class="bg-white border border-gray-300 overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead class="bg-gray-100 border-b border-gray-300 text-gray-700">
          <tr>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">ID Inscr.</th>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Année Scolaire</th>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Niveau</th>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Classe</th>
            <% if (['Secretariat', 'Proviseur'].includes(utilisateur.role)) { %>
              <th class="py-3 px-4 font-semibold text-right">Actions</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="tbody-inscriptions" class="divide-y divide-gray-300">
          <tr><td colspan="5" class="py-6 px-4 text-center text-gray-500">Entrez un ID d'élève.</td></tr>
        </tbody>
      </table>
    </div>
  </main>

  <div id="notification-container" class="notification-container"></div>
  <script src="/js/inscriptions.js"></script>

  <!-- Modal Nouvelle Inscription -->
  <div id="modal-inscription" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center p-4 z-50 hidden">
    <div class="bg-white p-6 border border-gray-400 w-full max-w-sm">
      <h3 class="text-xl font-bold mb-4">Inscrire un élève</h3>
      <form id="form-inscription" class="space-y-4">
        <div><label class="block text-sm font-semibold mb-1">ID Elève *</label><input type="number" id="insc-eleve-id" required min="1" class="w-full border p-2 text-sm"></div>
        <div><label class="block text-sm font-semibold mb-1">Année *</label><input type="text" id="insc-annee" required pattern="\d{4}-\d{4}" class="w-full border p-2 text-sm" placeholder="2025-2026"></div>
        <div class="flex gap-4">
          <div class="flex-1"><label class="block text-sm font-semibold mb-1">Niveau *</label><input type="number" id="insc-niveau" required min="3" max="6" class="w-full border p-2 text-sm"></div>
          <div class="flex-1"><label class="block text-sm font-semibold mb-1">Lettre *</label><input type="text" id="insc-lettre" required maxlength="1" class="w-full border p-2 text-sm"></div>
        </div>
        <div class="pt-2 flex justify-end gap-2">
          <button type="button" onclick="fermerModalInscription()" class="bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300">Annuler</button>
          <button type="submit" id="btn-submit-inscription" class="bg-blue-600 text-white px-4 py-2 text-sm font-medium hover:bg-blue-700">Inscrire</button>
        </div>
      </form>
    </div>
  </div>

  <div id="modal-confirm-insc" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white p-6 border border-gray-400 max-w-sm text-center">
      <h3 class="text-xl font-bold mb-2">Désinscrire ?</h3>
      <div class="flex justify-center gap-2 mt-4">
        <button onclick="fermerConfirmInsc()" class="bg-gray-200 px-4 py-2 text-sm font-medium">Annuler</button>
        <button id="btn-confirm-suppr-insc" class="bg-red-600 text-white px-4 py-2 text-sm font-medium">Supprimer</button>
      </div>
    </div>
  </div>
</body>
</html>
