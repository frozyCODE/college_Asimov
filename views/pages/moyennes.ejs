<!DOCTYPE html>
<html lang="fr" class="bg-gray-50">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-asimov-bg text-white font-sans selection:bg-asimov-accent/30 flex flex-col min-h-screen">
  
  <%- include('../partials/navbar', { currentRoute: '/moyennes' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
  </script>

  <main class="flex-1 max-w-7xl w-full mx-auto p-12">
    <header class="flex justify-between items-end mb-16">
      <div>
        <p class="text-asimov-accent text-[10px] font-black uppercase tracking-[0.4em] mb-4">Scolarité</p>
        <h1 class="text-6xl font-black tracking-tighter uppercase">Registre des Notes</h1>
      </div>
    </header>

    <!-- Selection Area -->
    <div class="bg-white/5 border border-white/10 p-8 rounded-[2rem] mb-12 flex flex-wrap gap-6 items-end">
      <div class="flex-1 min-w-[250px] space-y-3">
        <label class="text-[10px] font-black uppercase tracking-[0.3em] text-asimov-textMuted ml-1">Sélectionner un élève</label>
        <select id="select-student" class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm appearance-none cursor-pointer">
          <option value="">Chargement des élèves...</option>
        </select>
      </div>
      <div class="flex-1 min-w-[250px] space-y-3">
        <label class="text-[10px] font-black uppercase tracking-[0.3em] text-asimov-textMuted ml-1">Année Scolaire / Classe</label>
        <select id="select-inscription" disabled class="w-full bg-white/5 border border-white/10 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm appearance-none disabled:opacity-30 disabled:cursor-not-allowed">
          <option value="">Choisir un élève d'abord...</option>
        </select>
      </div>
    </div>

    <!-- Table Area -->
    <div class="bg-white/[0.02] border border-white/5 rounded-[2.5rem] overflow-hidden mb-12">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.04] text-white/70">
              <th class="py-10 px-8 font-wide uppercase tracking-[0.3em] text-[10px] first:pl-12">Semestre</th>
              <th class="py-10 px-8 font-wide uppercase tracking-[0.3em] text-[10px]">Moyenne Générale</th>
              <th class="py-10 px-8 font-wide uppercase tracking-[0.3em] text-[10px] text-right last:pr-12">Statut</th>
            </tr>
          </thead>
          <tbody id="tbody-moyennes" class="divide-y divide-white/[0.03]">
            <tr><td colspan="3" class="py-32 px-12 text-center text-asimov-textMuted uppercase tracking-widest text-[10px]">Veuillez sélectionner un dossier pour afficher les résultats...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Footer Action Form -->
    <section class="mt-20">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-[2px] w-12 bg-asimov-accent"></div>
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50">Saisie des résultats</h2>
      </div>
      
      <form id="form-add-grade" class="flex flex-wrap gap-4 items-end bg-white/[0.02] border border-white/5 p-8 rounded-[2rem] opacity-30 pointer-events-none transition-opacity duration-500">
        <div class="w-48 space-y-2">
          <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Moyenne (/20)</label>
          <input type="number" step="0.01" id="new-grade-val" min="0" max="20" required placeholder="Ex: 14.50" class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm">
        </div>
        <div class="w-48 space-y-2">
          <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Semestre</label>
          <select id="new-grade-sem" required class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm appearance-none cursor-pointer">
            <option value="1">Semestre 1</option>
            <option value="2">Semestre 2</option>
          </select>
        </div>
        <button type="submit" class="px-10 py-4 bg-asimov-accent text-white font-black uppercase tracking-[0.2em] rounded-xl shadow-glow hover:shadow-glow-lg transition-all active:scale-95">
          Enregistrer la note
        </button>
      </form>
    </section>
  </main>

  <div id="notification-container" class="notification-container"></div>
  <script src="/js/moyennes.js"></script>
</body>
</html>
</body>
</html>
