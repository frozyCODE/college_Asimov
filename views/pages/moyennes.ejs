<!DOCTYPE html>
<html lang="fr" class="bg-gray-50">
<head>
  <%- include('../partials/head') %>
</head>
<body class="flex flex-col min-h-screen text-gray-900 font-sans">
  
  <%- include('../partials/navbar', { currentRoute: '/moyennes' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
  </script>

  <main class="flex-1 max-w-6xl w-full mx-auto p-6 mt-4">
    <div class="flex justify-between items-end border-b pb-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold mb-1">Moyennes Semestrielles</h1>
        <p class="text-gray-600">Consultez, saisissez et validez les bulletins de notes.</p>
      </div>
      <% if (['Professeur', 'Proviseur'].includes(utilisateur.role)) { %>
        <button onclick="ouvrirModalAjoutMoyenne()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 text-sm">
          + Saisir une Moyenne
        </button>
      <% } %>
    </div>

    <!-- Recherche Moyennes -->
    <div class="bg-white p-4 border border-gray-300 mb-6 flex gap-2">
      <input type="number" id="input-insc-id" min="1" placeholder="ID inscription (ex: 1)" class="flex-1 px-3 py-2 border border-gray-300 focus:outline-none focus:border-blue-500 text-sm">
      <button id="btn-rechercher-moy" onclick="rechercherMoyennes()" class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 text-sm font-medium">Rechercher</button>
    </div>

    <!-- Table -->
    <div class="bg-white border border-gray-300 overflow-x-auto">
      <table class="w-full text-left border-collapse text-sm">
        <thead class="bg-gray-100 border-b border-gray-300 text-gray-700">
          <tr>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Semestre</th>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Moyenne / 20</th>
            <th class="py-3 px-4 font-semibold border-r border-gray-300">Statut</th>
            <% if (utilisateur.role === 'Proviseur') { %>
              <th class="py-3 px-4 font-semibold text-right">Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="tbody-moyennes" class="divide-y divide-gray-300">
          <tr><td colspan="4" class="py-6 px-4 text-center text-gray-500">Entrez un ID d'inscription.</td></tr>
        </tbody>
      </table>
    </div>
  </main>

  <div id="notification-container" class="notification-container"></div>
  <script src="/js/moyennes.js"></script>

  <!-- Modal Nouvelle Moyenne -->
  <div id="modal-moyenne" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden z-50">
    <div class="bg-white p-6 border border-gray-400 w-full max-w-sm">
      <h3 class="text-xl font-bold mb-4">Saisir une Moyenne</h3>
      <form id="form-moyenne" class="space-y-4">
        <div><label class="block text-sm font-semibold mb-1">ID Inscription *</label><input type="number" id="moy-insc-id" required min="1" class="w-full border bg-gray-100 p-2 text-sm" readonly></div>
        <div><label class="block text-sm font-semibold mb-1">Semestre *</label><input type="number" id="moy-semestre" required min="1" max="2" class="w-full border p-2 text-sm"></div>
        <div><label class="block text-sm font-semibold mb-1">Note *</label><input type="number" id="moy-val" required min="0" max="20" step="0.01" class="w-full border p-2 text-sm"></div>
        
        <div class="pt-2 flex justify-end gap-2">
          <button type="button" onclick="fermerModalMoyenne()" class="bg-gray-200 px-4 py-2 text-sm font-medium hover:bg-gray-300">Annuler</button>
          <button type="submit" id="btn-submit-moyenne" class="bg-blue-600 text-white px-4 py-2 text-sm font-medium hover:bg-blue-700">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
</body>
</html>
