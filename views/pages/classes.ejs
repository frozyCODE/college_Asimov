<!DOCTYPE html>
<html lang="fr" class="bg-asimov-bg">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-asimov-bg text-white font-sans selection:bg-asimov-accent/30 flex flex-col min-h-screen">
  
  <%- include('../partials/navbar', { currentRoute: '/classes' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
    window.TOUS_LES_ELEVES   = <%- JSON.stringify(eleves) %>;
    window.TOUTES_LES_CLASSES = <%- JSON.stringify(classes) %>;
  </script>

  <main class="flex-1 max-w-7xl w-full mx-auto p-12">
    <header class="flex justify-between items-end mb-16">
      <div>
        <p class="text-asimov-accent text-[10px] font-black uppercase tracking-[0.4em] mb-4">Structure Académique</p>
        <h1 class="text-6xl font-black tracking-tighter uppercase">Gestion des Classes</h1>
      </div>
    </header>

    <!-- Create Class Local Form -->
    <section class="mb-20">
      <div class="flex items-center gap-4 mb-8">
        <div class="h-[2px] w-12 bg-asimov-accent"></div>
        <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50">Ouverture de session</h2>
      </div>
      
      <form id="form-create-classe" class="flex flex-wrap gap-4 items-end bg-white/[0.02] border border-white/5 p-8 rounded-[2rem]">
        <div class="flex-1 min-w-[200px] space-y-2">
          <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Année Scolaire</label>
          <input type="text" id="cls-annee" required placeholder="ex: 2025-2026" class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm">
        </div>
        <div class="w-32 space-y-2">
          <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Niveau</label>
          <select id="cls-niveau" required class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm appearance-none">
            <option value="6">6ème</option>
            <option value="5">5ème</option>
            <option value="4">4ème</option>
            <option value="3" selected>3ème</option>
          </select>
        </div>
        <div class="w-32 space-y-2">
          <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Lettre</label>
          <input type="text" id="cls-lettre" required maxlength="1" placeholder="A" class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm text-center uppercase">
        </div>
        <button type="submit" class="px-10 py-4 bg-asimov-accent text-white font-black uppercase tracking-[0.2em] rounded-xl shadow-glow hover:bg-asimov-accentHover transition-all active:scale-95">
          Créer la classe
        </button>
      </form>
    </section>

    <!-- Main Content: Classes List & Effectif -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Left: Classes Table -->
      <div class="lg:col-span-7">
        <div class="flex items-center gap-4 mb-8">
          <div class="h-[2px] w-12 bg-white/20"></div>
          <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50">Registre des Classes</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-white/10 bg-white/[0.03] text-white/70">
                <th class="py-6 px-6 font-wide uppercase tracking-[0.3em] text-[10px] first:pl-8">ID</th>
                <th class="py-6 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">Formation</th>
                <th class="py-6 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">Session</th>
                <th class="py-6 px-6 font-wide uppercase tracking-[0.3em] text-[10px] text-right last:pr-8">Actions</th>
              </tr>
            </thead>
            <tbody id="tbody-classes" class="divide-y divide-white/[0.03]">
              <% classes.forEach(cls => { %>
                <tr class="group hover:bg-white/[0.02] cursor-pointer transition-colors" onclick="selectClasse(<%= cls.id %>, '<%= cls.niveau %>ème <%= cls.lettre %>')">
                  <td class="py-8 px-6 first:pl-8">
                    <span class="text-[10px] font-mono text-asimov-accent font-bold uppercase tracking-widest">#<%= cls.id %></span>
                  </td>
                  <td class="py-8 px-6">
                    <span class="text-lg font-clean font-black text-white"><%= cls.niveau %>ème <%= cls.lettre %></span>
                  </td>
                  <td class="py-8 px-6">
                    <span class="text-sm font-bold text-white/40"><%= cls.annee_scolaire %></span>
                  </td>
                  <td class="py-8 px-6 text-right last:pr-8">
                    <button onclick="event.stopPropagation(); deleteClasse(<%= cls.id %>)" class="p-2 text-white/20 hover:text-red-500 transition-colors">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </td>
                </tr>
              <% }) %>
              <% if (classes.length === 0) { %>
                <tr><td colspan="4" class="py-20 text-center text-asimov-textMuted uppercase tracking-widest text-[10px]">Aucune classe enregistrée.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Right: Effectif Management (Hidden till selection) -->
      <div class="lg:col-span-5 h-full">
        <div id="effectif-container" class="hidden h-full flex flex-col">
          <div class="flex items-center justify-between mb-8">
            <div class="flex items-center gap-4">
              <div class="h-[2px] w-12 bg-asimov-accent"></div>
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-white/50">Effectif : <span id="selected-classe-name" class="text-asimov-accent">...</span></h2>
            </div>
            <span id="effectif-count" class="text-[10px] font-black bg-white/5 px-3 py-1 rounded-full text-white/40">0 ÉLÈVES</span>
          </div>

          <div class="bg-white/[0.02] border border-white/5 p-8 rounded-[2.5rem] flex-1 flex flex-col">
            <!-- Add Student to Class -->
            <div class="mb-10 pb-10 border-b border-white/5">
              <label class="text-[9px] font-black uppercase tracking-widest text-asimov-textMuted ml-1 mb-3 block">Inscrire un étudiant</label>
              <div class="flex gap-2">
                <select id="select-new-eleve" class="flex-1 bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent transition-all text-sm appearance-none">
                  <option value="">Sélectionner un élève...</option>
                  <% eleves.forEach(e => { %>
                    <option value="<%= e.id %>"><%= e.prenom %> <%= e.nom %> (#<%= e.id %>)</option>
                  <% }) %>
                </select>
                <button onclick="inscrireEleve()" class="p-4 bg-asimov-accent text-white rounded-xl shadow-glow overflow-hidden active:scale-95 transition-all">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </button>
              </div>
            </div>

            <!-- List of students in class -->
            <div class="flex-1 overflow-y-auto pr-2 custom-scrollbar">
              <ul id="list-effectif" class="space-y-4">
                <!-- Rempli en JS -->
              </ul>
            </div>
          </div>
        </div>

        <!-- Empty State -->
        <div id="effectif-empty" class="h-full flex items-center justify-center border-2 border-dashed border-white/5 rounded-[2.5rem] p-12 text-center">
          <div class="space-y-4">
            <div class="w-16 h-16 bg-white/5 rounded-2xl flex items-center justify-center mx-auto text-white/20">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 15l-2 5L11 15m0 0l-5-2 5-2m0 10V4"></path></svg>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-white/20">Sélectionnez une classe pour gérer l'effectif</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <div id="notification-container" class="notification-container"></div>
  
  <script src="/js/classes.js"></script>

  <style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(255,255,255,0.02); }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(0,220,130,0.2); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(0,220,130,0.5); }
  </style>
</body>
</html>
