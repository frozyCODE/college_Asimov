<!DOCTYPE html>
<html lang="fr" class="bg-asimov-bg">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-asimov-bg text-white font-sans selection:bg-asimov-accent/30 flex flex-col min-h-screen">
  
  <%- include('../partials/navbar', { currentRoute: '/options' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
  </script>

  <main class="flex-1 max-w-7xl w-full mx-auto p-12">
    <header class="flex justify-between items-center mb-16">
      <div>
        <p class="text-asimov-accent text-[10px] font-black uppercase tracking-[0.4em] mb-4">Configurations</p>
        <h1 class="text-6xl font-black tracking-tighter uppercase">Options</h1>
      </div>
      <% if (['Secretariat', 'Proviseur'].includes(utilisateur.role)) { %>
        <button onclick="ouvrirModalAjoutOption()" class="px-8 py-4 bg-asimov-accent hover:bg-asimov-accentHover text-white font-black uppercase tracking-[0.2em] rounded-xl transition-all active:scale-[0.98]">
          + Nouvelle Option
        </button>
      <% } %>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="grid-options">
      <div class="col-span-full py-12 text-center text-asimov-textMuted italic">Chargement des options...</div>
    </div>
  </main>

  <div id="notification-container" class="notification-container"></div>
  <script src="/js/options.js"></script>

  <!-- Modale Simplifiée -->
  <div id="modal-option" class="fixed inset-0 bg-asimov-bg/90 backdrop-blur-sm flex items-center justify-center hidden z-[200] p-6">
    <div class="bg-asimov-bgSecondary p-12 rounded-3xl border border-white/10 w-full max-w-xl">
      <h3 class="text-3xl font-black uppercase tracking-tighter mb-10" id="modal-option-title">Option</h3>
      <form id="form-option" class="grid gap-8">
        <input type="hidden" id="option-id" />
        <div class="space-y-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Nom de l'option *</label>
          <input type="text" id="option-nom" required class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm" placeholder="ex: Arts Plastiques">
        </div>
        <div class="space-y-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Détails / Description</label>
          <textarea id="option-detail" class="w-full bg-white/5 border border-white/5 rounded-xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm min-h-[120px]" placeholder="Option facultative pour les classes de 3ème..."></textarea>
        </div>
        
        <div class="pt-6 flex justify-end gap-4">
          <button type="button" onclick="fermerModalOption()" class="px-8 py-4 bg-white/5 text-white font-black uppercase tracking-[0.2em] rounded-xl hover:bg-white/10 transition-colors">Annuler</button>
          <button type="submit" id="btn-submit-option" class="px-10 py-4 bg-asimov-accent text-white font-black uppercase tracking-[0.2em] rounded-xl transition-all font-bold">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Confirmation Suppression -->
  <div id="modal-confirmer-option" class="fixed inset-0 bg-asimov-bg/90 backdrop-blur-sm flex items-center justify-center hidden z-[200] p-6">
    <div class="bg-asimov-bgSecondary p-12 rounded-3xl border border-white/10 max-w-sm text-center">
      <div class="w-16 h-16 bg-red-500/10 text-red-500 rounded-2xl flex items-center justify-center mx-auto mb-6 border border-red-500/20">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
      </div>
      <h3 class="text-2xl font-black uppercase tracking-tighter mb-4">Supprimer ?</h3>
      <p class="text-asimov-textMuted text-sm font-medium mb-12">Cette action supprimera l'option du catalogue scolaire.</p>
      <div class="flex justify-center gap-4">
        <button onclick="fermerConfirmOption()" class="px-8 py-4 bg-white/5 text-white font-black uppercase tracking-[0.2em] rounded-xl font-bold">Annuler</button>
        <button id="btn-confirm-suppr-option" class="px-10 py-4 bg-red-600 text-white font-black uppercase tracking-[0.2em] rounded-xl font-bold shadow-lg shadow-red-600/20 transition-all hover:bg-red-700">Supprimer</button>
      </div>
    </div>
  </div>
</body>
</html>
