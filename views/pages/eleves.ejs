<!DOCTYPE html>
<html lang="fr" class="bg-gray-50">
<head>
  <%- include('../partials/head') %>
</head>
<body class="bg-asimov-bg text-white font-sans selection:bg-asimov-accent/30 flex flex-col min-h-screen">
  
  <%- include('../partials/navbar', { currentRoute: '/eleves' }) %>

  <script>
    window.ROLE_UTILISATEUR = "<%= utilisateur.role %>";
  </script>

  <main class="flex-1 max-w-7xl w-full mx-auto p-12">
    <header class="flex justify-between items-center mb-16">
      <div>
        <p class="text-asimov-accent text-[10px] font-black uppercase tracking-[0.4em] mb-4">Base de Données</p>
        <h1 class="text-6xl font-black tracking-tighter uppercase">Élèves</h1>
      </div>
      <% if (['Secretariat', 'Proviseur'].includes(utilisateur.role)) { %>
        <button onclick="ouvrirModalAjout()" class="px-8 py-4 bg-asimov-accent hover:bg-asimov-accentHover text-white font-black uppercase tracking-[0.2em] rounded-xl transition-all active:scale-[0.98]">
          + Nouvel Élève
        </button>
      <% } %>
    </header>

    <!-- Recherche -->
    <div class="bg-white/5 border border-white/10 p-6 rounded-2xl mb-12 flex gap-4">
      <div class="flex-1 relative group">
        <svg class="w-5 h-5 absolute left-6 top-1/2 -translate-y-1/2 text-asimov-textMuted group-focus-within:text-asimov-accent transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <input type="text" id="input-search-eleve" placeholder="Recherche par nom, prénom..." 
               class="w-full pl-16 pr-6 py-4 bg-white/5 border border-white/5 rounded-xl focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm placeholder-white/20">
      </div>
      <button onclick="rechercherEleves()" class="px-10 py-4 bg-white/10 hover:bg-white/20 text-white font-black uppercase tracking-[0.2em] rounded-xl transition-all border border-white/10">
        Rechercher
      </button>
    </div>

    <!-- Table Area -->
    <div class="mt-12">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-white/10 bg-white/[0.03] text-white/70">
              <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px] first:pl-8">ID</th>
              <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">Identité</th>
              <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">Contact</th>
              <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">CSV</th>
              <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px]">Référent</th>
              <% if (['Secretariat', 'Proviseur'].includes(utilisateur.role)) { %>
                <th class="py-8 px-6 font-wide uppercase tracking-[0.3em] text-[10px] text-right last:pr-8">Actions</th>
              <% } %>
            </tr>
          </thead>
          <tbody id="tbody-eleves" class="divide-y divide-white/[0.03]">
            <!-- Rempli en JS -->
            <tr><td colspan="6" class="py-32 px-6 text-center text-asimov-textMuted uppercase tracking-widest text-[10px] first:pl-0">Utilisez la recherche pour extraire les données...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <div id="notification-container" class="notification-container"></div>
  <script src="/js/eleves.js"></script>

  <!-- Modales avec style Premium Dark -->
  <div id="modal-eleve" class="fixed inset-0 bg-asimov-bg/80 backdrop-blur-xl flex items-center justify-center hidden z-[200] p-6">
    <div class="glass p-12 rounded-[2.5rem] shadow-glow-lg w-full max-w-xl border border-white/10">
      <h3 class="text-3xl font-black uppercase tracking-tighter mb-10" id="modal-eleve-title">Élève</h3>
      <form id="form-eleve" class="grid gap-8">
        <input type="hidden" id="eleve-id" />
        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Nom *</label>
            <input type="text" id="eleve-nom" required class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm">
          </div>
          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Prénom *</label>
            <input type="text" id="eleve-prenom" required class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm">
          </div>
        </div>
        <div class="space-y-2">
          <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Email académique *</label>
          <input type="email" id="eleve-email" required class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm">
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">Code CSV</label>
            <input type="text" id="eleve-csv" class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm">
          </div>
          <div class="space-y-2">
            <label class="text-[10px] font-black uppercase tracking-widest text-asimov-textMuted ml-1">ID Référent</label>
            <input type="number" id="eleve-ref" class="w-full bg-white/5 border border-white/5 rounded-2xl px-6 py-4 focus:outline-none focus:border-asimov-accent focus:bg-white/10 transition-all text-sm">
          </div>
        </div>
        
        <div class="pt-6 flex justify-end gap-4">
          <button type="button" onclick="fermerModalEleve()" class="px-8 py-4 bg-white/5 text-white font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white/10 transition-colors">Annuler</button>
          <button type="submit" id="btn-submit-eleve" class="px-10 py-4 bg-asimov-accent text-white font-black uppercase tracking-[0.2em] rounded-2xl shadow-glow transition-all">Enregistrer</button>
        </div>
      </form>
    </div>
  </div>

  <div id="modal-confirm" class="fixed inset-0 bg-asimov-bg/80 backdrop-blur-xl flex items-center justify-center hidden z-[200] p-6">
    <div class="glass p-12 rounded-[2.5rem] shadow-glow-lg max-w-md text-center border border-white/10">
      <div class="w-20 h-20 bg-red-500/10 text-red-500 rounded-3xl flex items-center justify-center mx-auto mb-8 border border-red-500/20 shadow-[0_0_30px_rgba(239,68,68,0.2)]">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
      </div>
      <h3 class="text-3xl font-black uppercase tracking-tighter mb-4">Supprimer ?</h3>
      <p class="text-asimov-textMuted text-sm font-medium mb-12">L'action est irréversible. Les données de l'élève seront effacées des serveurs.</p>
      <div class="flex justify-center gap-4">
        <button onclick="fermerConfirm()" class="px-8 py-4 bg-white/5 text-white font-black uppercase tracking-[0.2em] rounded-2xl">Annuler</button>
        <button id="btn-confirm-suppr" class="px-10 py-4 bg-red-600 text-white font-black uppercase tracking-[0.2em] rounded-2xl shadow-[0_0_30px_rgba(220,38,38,0.3)] transition-all hover:bg-red-700">Confirmer</button>
      </div>
    </div>
  </div>
</body>
</html>
